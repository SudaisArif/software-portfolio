{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tartan-fantasy-cmu",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-29",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/data/live-scores.json",
      "/data/gameweek-stats.json"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tartan-fantasy-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOW_LOCKED_WRITES": "0"
  }
}
